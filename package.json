{
  "name": "xiv-market",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "app"
  ],
  "scripts": {
    "dev": "bun run --cwd app dev",
    "build": "bun run --cwd app build",
    "preview": "bun run --cwd app preview",
    "update-items": "bun run scripts/update-items.ts",
    "test": "bun test tests/*.test.ts",
    "check-report": "bun scripts/check-item-report.ts"
  }
}
